# Copy to .env (never commit .env)
ENV=development                      # development | production
DATABASE_URL=sqlite:///./kiosk.db    # production: the PostgreSQL URL from Neon/Supabase
SECRET_KEY=change-me-to-a-long-random-string-of-32-plus-characters
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000
INITIAL_PASSWORD_FORMAT=ddmmyyyy     # first-login password = date of birth, forced change at first login
ATTENDANCE_MIN_PERCENT=75
# STAFF_SEE_CONTACT=false            # true = counsellors/HOD can see students' mobile and email
# SEED_STAFF_PASSWORD=ChangeMe-2026  # demo seed only
